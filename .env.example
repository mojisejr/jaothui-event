# Local example only. Supply real server credentials privately, never in NEXT_PUBLIC_*.
DATABASE_URL="postgresql://local:local@127.0.0.1:5432/jaothui"
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="dev"
SANITY_API_WRITE_TOKEN=""
NEXT_PUBLIC_LIFF_ID=""
LINE_LOGIN_CHANNEL_ID=""
oa_token=""

# Source REST bridge: match the dashboard server-only key (minimum 32 characters).
JAOTHUI_COMPETITION_ADMIN_API_KEY=""
JAOTHUI_COMPETITION_ADMIN_WRITES_ENABLED="false"
COMPETITION_LINE_NOTIFICATIONS_ENABLED="false"

# Enable only after source + dashboard deployment and operator acceptance.
# Source SERVER variables; HTTPS origin or exact /dashboard/competitions base.
# Loopback HTTP is allowed only outside production.
COMPETITION_LEGACY_ADMIN_DISABLED="false"
JAOTHUI_COMPETITION_DASHBOARD_URL="https://dboard.jaothui.com"

# Mobile application QR. Server-only, separate from the bridge/admin secret.
# Generate >=32 unpredictable characters privately. Rotation invalidates old QR links.
# Keep empty to disable QR issuance; registration/check-in policy reads remain usable.
CHECKIN_QR_SECRET=""
# HTTPS origin where staff scan links open. Defaults to the production dashboard.
CHECKIN_DASHBOARD_URL="https://dboard.jaothui.com"

# Native applicant bridge: dedicated server-to-server key, never the admin/QR key.
JAOTHUI_COMPETITION_APPLICANT_BRIDGE_KEY=""

# Same-browser Front applicant SSO (#129). OFF until Front migration/configuration is ready.
JAOTHUI_EVENT_SSO_ENABLED=false
JAOTHUI_FRONT_ORIGIN=https://jaothui.com
JAOTHUI_EVENT_ORIGIN=https://event.example.com
# Dedicated shared server credential and independent Event cookie-signing key, >=32 characters.
JAOTHUI_EVENT_SSO_CLIENT_SECRET=
JAOTHUI_EVENT_SSO_STATE_SECRET=
