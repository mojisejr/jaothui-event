LINE_LOGIN_CHANNEL_ID=""
oa_token=""

# Source REST bridge: match the dashboard server-only key (minimum 32 characters).
JAOTHUI_COMPETITION_ADMIN_API_KEY=""
JAOTHUI_COMPETITION_ADMIN_WRITES_ENABLED="false"
COMPETITION_LINE_NOTIFICATIONS_ENABLED="false"

# Enable only after source + dashboard deployment and operator acceptance.
# Source SERVER variables; HTTPS origin or exact /dashboard/competitions base.
# Loopback HTTP is allowed only outside production.
COMPETITION_LEGACY_ADMIN_DISABLED="false"
JAOTHUI_COMPETITION_DASHBOARD_URL="https://dboard.jaothui.com"
